{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mozcloud-opentelemetry",
  "type": "object",
  "properties": {
    "global": {
      "description": "Global values dictionary",
      "type": "object",
      "properties": {
        "mozcloud": {
          "type": "object",
          "properties": {
            "app_code": {
              "description": "Tenant's application code (eg. sumo, ads, remote-settings). This is automatically populated by Argo CD.",
              "type": "string"
            },
            "artifact_id": {
              "description": "The 8 character short revision of the Helm chart deployed by Argo CD. This is automatically populated by Argo CD.",
              "type": "string"
            },
            "chart": {
              "description": "The name of the chart. This will match the app_code in single chart applications. This is automatically populated by Argo CD.",
              "type": "string"
            },
            "component_code": {
              "description": "Application component's code (eg. web, shepherd, mars)",
              "type": "string"
            },
            "env_code": {
              "description": "Environment (ie. dev, stage, prod). This is automatically populated by Argo CD.",
              "type": "string"
            },
            "image": {
              "description": "The container image repository and tag. This can be managed by Argo Image Updater.",
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                }
              }
            },
            "project_id": {
              "description": "GCP project ID. This is automatically populated by Argo CD.",
              "type": "string"
            },
            "realm": {
              "description": "A high-level grouping of infrastructure environments that share common networking and management boundaries (ie. nonprod, prod). This is automatically populated by Argo CD.",
              "type": "string"
            }
          },
          "required": [
            "app_code",
            "chart",
            "component_code",
            "env_code",
            "project_id",
            "realm"
          ]
        }
      }
    },
    "mozcloud-labels-lib": {
      "type": "object"
    },
    "collectors": {
      "type": "object",
      "properties": {
        "daemonset": {
          "type": "object",
          "properties": {
            "priorityClassName": {
              "description": "PriorityClass for the daemonset collectors. Defaults to gmp-critical, a non-reserved high-priority class so the scheduler can preempt lower-priority workloads.",
              "type": "string"
            },
            "tolerations": {
              "description": "Tolerations for the daemonset collector pods, allowing them to schedule onto nodes with matching taints. A list of Kubernetes toleration objects.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "securityContext": {
              "type": "object",
              "properties": {
                "allowPrivilegeEscalation": {
                  "type": "boolean"
                },
                "capabilities": {
                  "type": "object",
                  "properties": {
                    "drop": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "privileged": {
                  "type": "boolean"
                },
                "runAsUser": {
                  "type": "integer"
                },
                "runAsGroup": {
                  "type": "integer"
                },
                "runAsNonRoot": {
                  "type": "boolean"
                },
                "seccompProfile": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    }
                  }
                }
              },
              "additionalProperties": true
            },
            "resources": {
              "$ref": "#/$defs/resources"
            },
            "startupProbe": {
              "$ref": "#/$defs/startupProbe"
            }
          }
        },
        "gateway": {
          "type": "object",
          "properties": {
            "endpoints": {
              "type": "object",
              "properties": {
                "otlp": {
                  "type": "object",
                  "properties": {
                    "endpoint": {
                      "type": "string"
                    },
                    "port": {
                      "type": "string"
                    }
                  }
                },
                "headless": {
                  "type": "object",
                  "properties": {
                    "endpoint": {
                      "type": "string"
                    },
                    "port": {
                      "type": "string"
                    }
                  }
                },
                "statsd": {
                  "type": "object",
                  "properties": {
                    "endpoint": {
                      "type": "string"
                    },
                    "port": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "statsdService": {
              "type": "object",
              "properties": {
                "enabled": {
                  "description": "Create a separate ClusterIP Service with sessionAffinity: ClientIP for statsd traffic, ensuring the same source IP always reaches the same gateway collector pod.",
                  "type": "boolean"
                },
                "sessionAffinityTimeoutSeconds": {
                  "description": "Seconds the kube-proxy remembers a client IP → pod mapping. Defaults to 10800 (3 hours).",
                  "type": "integer"
                }
              }
            },
            "securityContext": {
              "type": "object",
              "properties": {
                "allowPrivilegeEscalation": {
                  "type": "boolean"
                },
                "capabilities": {
                  "type": "object",
                  "properties": {
                    "drop": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "privileged": {
                  "type": "boolean"
                },
                "runAsUser": {
                  "type": "integer"
                },
                "runAsGroup": {
                  "type": "integer"
                },
                "runAsNonRoot": {
                  "type": "boolean"
                },
                "seccompProfile": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    }
                  }
                }
              },
              "additionalProperties": true
            },
            "autoscaler": {
              "type": "object",
              "properties": {
                "minReplicas": {
                  "type": "integer"
                },
                "maxReplicas": {
                  "type": "integer"
                },
                "targetCPUUtilization": {
                  "type": "integer"
                },
                "targetMemoryUtilization": {
                  "type": "integer"
                }
              }
            },
            "resources": {
              "$ref": "#/$defs/resources"
            },
            "startupProbe": {
              "$ref": "#/$defs/startupProbe"
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "project_id": {
      "type": "string"
    }
  },
  "$defs": {
    "quantity": {
      "description": "A Kubernetes resource quantity, either a string (eg. 500m, 2Gi) or a number.",
      "type": ["string", "number"]
    },
    "resourceList": {
      "type": "object",
      "properties": {
        "cpu": {
          "$ref": "#/$defs/quantity"
        },
        "memory": {
          "$ref": "#/$defs/quantity"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/quantity"
      }
    },
    "resources": {
      "description": "Compute resources for the collector container.",
      "type": "object",
      "properties": {
        "limits": {
          "$ref": "#/$defs/resourceList"
        },
        "requests": {
          "$ref": "#/$defs/resourceList"
        }
      },
      "additionalProperties": false
    },
    "startupProbe": {
      "description": "Startup probe timings for the collector container. The OpenTelemetry Operator sets the probe handler, so only timing fields are configurable.",
      "type": "object",
      "properties": {
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
