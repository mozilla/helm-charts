        realm: nonprod
      name: ingress-host
    spec:
      rules:
        - host: ingress-host.dev.test-domain.com
          http:
            paths:
              - backend:
                  service:
                    name: inherits
                    port:
                      number: 8080
                path: /
                pathType: Prefix
              - backend:
                  service:
                    name: silenced
                    port:
                      number: 8080
                path: /quiet
                pathType: Exact
