        networking.gke.io/managed-certificates: iap-host-dev-test-domain-com
        networking.gke.io/v1beta1.FrontendConfig: iap-host
      labels:
        app.kubernetes.io/component: app
        app.kubernetes.io/managed-by: argocd
        app.kubernetes.io/name: mozcloud-test
        app_code: mozcloud-test
        component_code: app
        env_code: dev
        helm.sh/chart: test-chart
        mozcloud_chart: mozcloud
        mozcloud_chart_version: 1.0.0
        realm: nonprod
      name: iap-host
    spec:
      rules:
        - host: iap-host.dev.test-domain.com
          http:
            paths:
              - backend:
                  service:
                    name: app
                    port:
                      number: 8080
                path: /
                pathType: Prefix
              - backend:
                  service:
                    name: app-webhook
                    port:
                      number: 8080
                path: /bugzilla_webhook
                pathType: Exact
