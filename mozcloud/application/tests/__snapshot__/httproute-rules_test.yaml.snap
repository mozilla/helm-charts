  9: |
    apiVersion: gateway.networking.k8s.io/v1
    kind: HTTPRoute
    metadata:
      labels:
        app.kubernetes.io/component: web
        app.kubernetes.io/managed-by: argocd
        app.kubernetes.io/name: mozcloud-test
        app_code: mozcloud-test
        component_code: web
        env_code: dev
        helm.sh/chart: test-chart
        mozcloud_chart: mozcloud
        mozcloud_chart_version: 1.0.0
        realm: nonprod
      name: rule-filters
    spec:
      hostnames:
        - rule.filters
      parentRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: mozcloud-test
          sectionName: https
      rules:
        - backendRefs:
            - group: ""
              kind: Service
              name: test-service
              port: 8080
              weight: 1
          filters:
            - requestMirror:
                backendRef:
                  kind: Service
                  name: test-service-shadow
                  port: 8080
              type: RequestMirror
            - responseHeaderModifier:
                set:
                  - name: X-Shadowed
                    value: "true"
              type: ResponseHeaderModifier
          matches:
            - path:
                type: PathPrefix
                value: /foo
